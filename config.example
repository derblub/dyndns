# dyndns configuration – copy to ~/.config/dyndns/config, chmod 600, fill in your values.
# Override the location with the DYNDNS_CONFIG environment variable.
DNS_RESOLVER="ns1.example.com"          # resolver used to look up the current DNS record
DNS_TABLE="dns_records"                 # table holding the A record (MySQL on the remote host)
REMOTEUSER="user"                       # SSH user on the DNS server
REMOTEHOST="dns.example.com"            # DNS server (reached via SSH)
MAILTO="you@example.com"                # notification recipient
SMTPSERVER="smtp.example.com"
SMTPPORT="587"
SMTPFROM="dyndns@example.com"
SMTPUSER="dyndns@example.com"
SMTPPASSWORD="change-me"                # or: . ~/.config/tools/secrets.env and use "$SMTP_PASSWORD"
IDENTITY="$HOME/.ssh/id_ed25519"        # SSH key for REMOTEHOST
DOMAIN="home.example.com"               # record to update
LOG_FILE="$HOME/.local/state/dyndns.log"
LAST_WAN_IP="$HOME/.local/state/dyndns.last-ip"
